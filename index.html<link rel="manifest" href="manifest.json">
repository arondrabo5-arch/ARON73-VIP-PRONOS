function renderFavoris() {
  const zone = $('listeFavoris');
  zone.replaceChildren();

  if (!favoris.length) {
    zone.textContent = 'Aucun favori enregistré.';
    return;
  }

  favoris.forEach(m => {
    const p = document.createElement('p');
    p.textContent = m.homeTeam.name + ' - ' + m.awayTeam.name;
    zone.appendChild(p);
  });
}

function renderHistorique() {
  const zone = $('listeHistorique');
  zone.replaceChildren();

  if (!historique.length) {
    zone.textContent = 'Aucun pronostic enregistré.';
    return;
  }

  historique.forEach(f => {
    const div = document.createElement('div');
    div.className = 'match';
    const titre = document.createElement('h3');
    titre.textContent = f.match;
    const details = document.createElement('p');
    details.className = 'note';
    details.textContent = 'Créée le ' + f.date;
    div.append(titre, details);
    zone.appendChild(div);
  });
}

function suivre() {
  const prevu = $('scoreprevu').value.trim();
  const reel = $('scorereel').value.trim();
  const zone = $('comparaison');

  if (!prevu || !reel) {
    zone.textContent = 'Entre le score pronostiqué et le score réel.';
    return;
  }

  zone.textContent = prevu === reel
    ? 'Le score exact est correct : ' + prevu
    : 'Pronostiqué : ' + prevu + ' · Réel : ' + reel;
}

function vipInfo() {
  const telephone = $('telephone').value.trim();
  const paiement = $('paiement').value;
  $('vipMessage').textContent =
    'Moyen choisi : ' + paiement +
    '. Contact : ' + (telephone || 'non renseigné') +
    '. L’accès VIP nécessite une validation manuelle. Aucun paiement n’a été effectué.';
}

try {
  const savedKey = localStorage.getItem('aron73_api_key');
  if (savedKey) $('apiKey').value = savedKey;
} catch (e) {
  $('etat').textContent = 'Stockage local indisponible.';
}

const today = new Date().toISOString().slice(0,10);
$('debut').value = today;
$('fin').value = today;
</script>
</body>
</html>
